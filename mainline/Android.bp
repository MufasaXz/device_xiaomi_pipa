// SPDX-License-Identifier: Apache-2.0
prebuilt_etc {
    name: "init.pipa.mainline.memfd.rc",
    src: "init.pipa.mainline.memfd.rc",
    sub_dir: "init",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "ueventd.pipa.mainline.rc",
    src: "ueventd.pipa.mainline.rc",
    filename: "ueventd.rc",
    device_specific: true,
}

// Source groups are selected by the common rootdir modules only for pipa.
filegroup {
    name: "pipa.mainline.fstab",
    srcs: ["fstab.pipa.mainline"],
}

filegroup {
    name: "pipa.mainline.init.target",
    srcs: ["init.target.pipa.mainline.rc"],
}

filegroup {
    name: "pipa.mainline.init.recovery",
    srcs: ["init.recovery.qcom.pipa.mainline.rc"],
}
