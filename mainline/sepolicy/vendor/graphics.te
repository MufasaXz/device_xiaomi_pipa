# Mesa and minigbm enumerate DRM nodes, unlike the downstream KGSL stack.
allow { hal_graphics_allocator_default hal_graphics_composer_default surfaceflinger bootanim } gpu_device:dir r_dir_perms;
allow { hal_graphics_allocator_default hal_graphics_composer_default } gpu_device:chr_file rw_file_perms;

# DRM composer imports minigbm buffers and listens for connector hotplug events.
hal_client_domain(hal_graphics_composer_default, hal_graphics_allocator)
allow hal_graphics_composer_default hal_graphics_allocator_default_tmpfs:file { getattr map read write };
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket { bind create read };
get_prop({ hal_graphics_allocator_default hal_graphics_composer_default gpu_sphal_domain }, vendor_pipa_mainline_graphics_prop)
