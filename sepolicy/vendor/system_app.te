set_prop(system_app, vendor_pen_prop)

# Allow system_app (PipaCore) to write CPU cpufreq, GPU KGSL, and Battery supply nodes (Bypass Charging)
allow system_app sysfs_devices_system_cpu:file rw_file_perms;
allow system_app vendor_sysfs_kgsl:file rw_file_perms;
allow system_app vendor_sysfs_battery_supply:file rw_file_perms;
allow system_app vendor_sysfs_battery_supply:dir search;
allow system_app sysfs_battery_supply:file rw_file_perms;
allow system_app sysfs_battery_supply:dir search;
